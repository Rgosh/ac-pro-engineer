# The Linux builds of the window and the launcher, against an old glibc.
#
# A binary linked on a rolling distro asks for that distro's glibc: built on
# Arch with 2.44 it refused to start on 2.43 ("GLIBC_2.44 not found"), which
# is most of the Linux installs in the world. Built on 22.04 (2.35) it then
# refused Ubuntu 20.04 and Debian 11 ("GLIBC_2.33 not found"). Ubuntu 20.04
# has 2.31, so what is built here runs there and on everything newer; the
# base is an argument so a build that cannot be made on it can fall back to
# 22.04 for one release (`PE_LINUX_BASE=22.04`). The Rust is pinned to the
# one the gates run, so the container builds what was tested.
ARG BASE=20.04
FROM docker.io/library/ubuntu:${BASE}
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates curl build-essential pkg-config git \
 && rm -rf /var/lib/apt/lists/*
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo PATH=/usr/local/cargo/bin:$PATH
ARG RUST=1.98.0
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain $RUST \
 && rustc --version
